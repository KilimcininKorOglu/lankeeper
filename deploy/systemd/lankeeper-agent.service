[Unit]
Description=LANKeeper Privileged Agent
PartOf=lankeeper.target
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/lankeeper agent
Restart=always
RestartSec=3

User=root
RuntimeDirectory=lankeeper
RuntimeDirectoryMode=0755

# No filesystem namespace. The agent exists to write /etc, replace the
# binary in /usr/local/bin and mount storage for the whole system, and
# its boundary is the command and path whitelist. ProtectSystem=full
# made /etc and /usr read-only for it, and any namespace (ProtectSystem,
# ProtectHome, PrivateTmp) kept its mounts out of the host's view.
NoNewPrivileges=false

[Install]
WantedBy=lankeeper.target
