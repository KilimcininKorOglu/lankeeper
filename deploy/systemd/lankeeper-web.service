[Unit]
Description=LANKeeper Web Server
PartOf=lankeeper.target
After=lankeeper-agent.service
Requires=lankeeper-agent.service

[Service]
Type=simple
ExecStart=/usr/local/bin/lankeeper serve
Restart=always
RestartSec=3

User=lankeeper
Group=lankeeper
# /run/lankeeper belongs to the agent unit alone. Declared here too,
# systemd deleted it (and the agent socket) whenever this unit stopped and
# re-owned it and the socket to this account whenever it started.

AmbientCapabilities=CAP_NET_BIND_SERVICE
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
# /srv and /mnt hold the media directories the M3U sync writes playlists
# into as this user. The '-' keeps a missing directory from stopping the
# unit from starting.
ReadWritePaths=/etc/lankeeper /var/lib/lankeeper /var/log/lankeeper -/srv -/mnt

[Install]
WantedBy=lankeeper.target
